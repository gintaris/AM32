// J-Link Commander script for the KIT_PSC3M5_2GO (on-board J-Link LITE).
// Programs the boot stub and the AM32 firmware, then runs it.
// From the repository root, after make psc3_boot_stub and make KIT_2GO_PSC3:
//   JLink -CommanderScript Mcu/psc3/jlink_flash.jlink
// J-Link has no PSC3M5 part name: PSC3xxF is the generic 256 kB PSC3. Its
// flash loader takes the S-AHB alias 0x32000000 only, not the C-AHB alias
// 0x12000000 the images are linked for, so the binaries are loaded there.
// The firmware binary starts at the vector table (0x12001000) and runs to
// the end of the flash, so it also clears the settings row.
device PSC3xxF
si SWD
speed 4000
connect
r
h
loadbin obj/PSC3_BOOT_STUB.bin 0x32000000
loadbin obj/AM32_KIT_2GO_PSC3_2.21.bin 0x32001000
verifybin obj/AM32_KIT_2GO_PSC3_2.21.bin 0x32001000
r
g
exit
